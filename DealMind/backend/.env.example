# ==============================================================================
# DealMind Backend Environment Configuration
# ==============================================================================

# Server Port (Default: 5001)
PORT=5001

# ------------------------------------------------------------------------------
# 1. Hindsight Cloud Configuration (Persistent Agent Memory)
# ------------------------------------------------------------------------------
# Create an account, org, and memory bank at: https://ui.hindsight.vectorize.io
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=your_hindsight_bank_id_here

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Preferred Option: Google Gemini API (Get key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Alternative Option: OpenAI API (Get key at https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
